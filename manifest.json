{
  "manifest_version": 3,
  "name": "Quest Panel",
  "version": "0.1.0",
  "description": "A calm, progress-focused companion panel for your day.",
  "permissions": ["sidePanel", "identity", "storage"],
  "background": { "service_worker": "src/background.ts", "type": "module" },
  "action": { "default_title": "Open Quest Panel" },
  "side_panel": { "default_path": "index.html" }
}
